<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="A practical career exploration guide for Senior High School students in the Philippines.">
  <meta name="theme-color" content="#f8fafc">
  <title>Self Discovery and Career Toolkit</title>
  <style>
    :root {
      color-scheme: light dark;
      --ink: #20313d;
      --muted: #5b6b75;
      --canvas: #f8fafc;
      --surface: #ffffff;
      --soft: #eef5f8;
      --line: #dce6eb;
      --blue: #1768a6;
      --blue-deep: #124c77;
      --blue-soft: #e6f2fa;
      --green: #2e7668;
      --green-soft: #e8f3ef;
      --gold: #b66a2c;
      --gold-soft: #fff2e5;
      --shadow: 0 10px 30px rgba(30, 61, 77, .07);
      --radius: 18px;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --ink: #f2f6f8;
        --muted: #bdc9cf;
        --canvas: #151d22;
        --surface: #202b32;
        --soft: #26343c;
        --line: #3b4a52;
        --blue: #7ab9e8;
        --blue-deep: #a9d4f2;
        --blue-soft: #20394a;
        --green: #8bceb9;
        --green-soft: #223a34;
        --gold: #f0b77e;
        --gold-soft: #3a2b20;
        --shadow: 0 10px 30px rgba(0,0,0,.20);
      }
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 104px; }
    body {
      margin: 0;
      background: var(--canvas);
      color: var(--ink);
      font: 16px/1.6 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    a { color: var(--blue-deep); text-underline-offset: 3px; }
    a:hover { text-decoration-thickness: 2px; }
    a:focus-visible, button:focus-visible, textarea:focus-visible, input:focus-visible, summary:focus-visible {
      outline: 3px solid #73b5e6;
      outline-offset: 3px;
      border-radius: 5px;
    }
    .skip-link {
      position: absolute; left: 12px; top: -60px; z-index: 20;
      padding: 10px 14px; background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: 8px;
    }
    .skip-link:focus { top: 12px; }
    .site-header {
      position: sticky; top: 0; z-index: 10;
      background: color-mix(in srgb, var(--canvas) 92%, transparent);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(14px);
    }
    .header-inner { max-width: 1120px; margin: auto; padding: 12px 28px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-weight: 750; letter-spacing: -.02em; white-space: nowrap; }
    .brand-mark { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 11px; color: #fff; background: #1768a6; font-size: 17px; }
    .nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 5px; }
    .nav a { padding: 8px 10px; color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 600; border-radius: 8px; }
    .nav a:hover { background: var(--soft); color: var(--ink); }
    main { max-width: 1120px; margin: 0 auto; padding: 36px 28px 72px; }
    .hero {
      position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(260px, .7fr); gap: 36px;
      align-items: center; padding: 58px 56px; border-radius: 26px;
      background: linear-gradient(120deg, var(--blue-soft), var(--surface) 75%);
      border: 1px solid var(--line);
    }
    .eyebrow { margin: 0 0 12px; color: var(--blue-deep); font-weight: 750; letter-spacing: .1em; text-transform: uppercase; font-size: 12px; }
    h1, h2, h3 { line-height: 1.18; letter-spacing: -.035em; }
    h1 { max-width: 680px; margin: 0; font-size: clamp(38px, 5.5vw, 66px); }
    h2 { font-size: clamp(28px, 3.4vw, 40px); margin: 0 0 12px; }
    h3 { font-size: 20px; margin: 0 0 9px; }
    .hero-copy { max-width: 610px; margin: 20px 0 24px; color: var(--muted); font-size: 18px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
    .button { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; padding: 10px 17px; border-radius: 10px; background: var(--blue); color: #fff; text-decoration: none; font-weight: 700; border: 1px solid var(--blue); }
    .button:hover { background: var(--blue-deep); color: #fff; }
    .button.secondary { background: var(--surface); color: var(--blue-deep); border-color: var(--line); }
    .button.secondary:hover { background: var(--soft); }
    .hero-aside { position: relative; z-index: 1; padding: 24px; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow); }
    .hero-aside h2 { font-size: 18px; margin: 0 0 16px; }
    .steps-mini { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
    .steps-mini li { display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 14px; }
    .step-no { display: grid; flex: 0 0 29px; height: 29px; place-items: center; border-radius: 9px; background: var(--blue-soft); color: var(--blue-deep); font-size: 13px; font-weight: 800; }
    .section { padding: 76px 0 0; scroll-margin-top: 96px; }
    .section-heading { max-width: 720px; margin-bottom: 28px; }
    .section-heading p { color: var(--muted); margin: 0; font-size: 17px; }
    .label { display: block; color: var(--green); text-transform: uppercase; letter-spacing: .09em; font-size: 12px; font-weight: 800; margin-bottom: 9px; }
    .grid { display: grid; gap: 16px; }
    .grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .card { padding: 23px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
    .card p { color: var(--muted); margin: 0; }
    .card .icon { display: grid; width: 40px; height: 40px; place-items: center; margin-bottom: 15px; border-radius: 12px; background: var(--blue-soft); color: var(--blue-deep); font-size: 18px; font-weight: 800; }
    .card.green .icon { background: var(--green-soft); color: var(--green); }
    .card.gold .icon { background: var(--gold-soft); color: var(--gold); }
    .list-clean { margin: 12px 0 0; padding-left: 20px; color: var(--muted); }
    .list-clean li { margin: 7px 0; }
    .callout { padding: 19px 22px; border-left: 4px solid var(--gold); border-radius: 0 12px 12px 0; background: var(--gold-soft); color: var(--ink); }
    .callout p { margin: 0; }
    .prompt-list { display: grid; gap: 10px; margin-top: 16px; }
    .prompt { padding: 13px 15px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
    .prompt strong { color: var(--ink); }
    .career-card { border-top: 3px solid var(--blue); }
    .career-fields { display: grid; gap: 10px; padding: 0; margin: 15px 0 0; list-style: none; }
    .career-fields li { display: flex; gap: 9px; color: var(--muted); }
    .career-fields li::before { content: "□"; color: var(--blue); font-weight: 800; }
    .pathway { height: 100%; }
    .pathway .path-tag { display: inline-block; margin-bottom: 14px; padding: 4px 9px; background: var(--blue-soft); color: var(--blue-deep); border-radius: 6px; font-size: 12px; font-weight: 750; }
    .pathway.green .path-tag { background: var(--green-soft); color: var(--green); }
    .pathway.gold .path-tag { background: var(--gold-soft); color: var(--gold); }
    .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 13px; background: var(--surface); }
    table { width: 100%; border-collapse: collapse; min-width: 700px; }
    th, td { padding: 14px 15px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
    th { background: var(--soft); font-size: 13px; letter-spacing: .02em; }
    td { height: 55px; color: var(--muted); }
    tr:last-child td { border-bottom: 0; }
    .planner { padding: 25px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
    .planner-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .field { display: grid; gap: 6px; }
    .field.full { grid-column: 1 / -1; }
    label { font-size: 14px; font-weight: 700; }
    input, textarea { width: 100%; min-height: 44px; padding: 11px 12px; border: 1px solid var(--line); border-radius: 9px; background: var(--canvas); color: var(--ink); font: inherit; }
    textarea { min-height: 90px; resize: vertical; }
    .planner-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 18px; }
    button { cursor: pointer; font: inherit; }
    .small-note { color: var(--muted); font-size: 13px; }
    .resource-group { margin-top: 26px; }
    .resource-group h3 { margin-bottom: 12px; }
    .resource-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .resource { padding: 17px 18px; background: var(--surface); border: 1px solid var(--line); border-radius: 13px; }
    .resource a { display: inline-block; font-weight: 750; }
    .resource p { margin: 5px 0 0; color: var(--muted); font-size: 14px; }
    .resource .caution { color: var(--gold); }
    .quiz-shell { padding: 25px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
    .quiz-question + .quiz-question { margin-top: 25px; }
    .quiz-question h3 { margin-bottom: 12px; }
    .choice-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .choice { min-height: 48px; padding: 10px 12px; text-align: left; color: var(--ink); background: var(--canvas); border: 1px solid var(--line); border-radius: 10px; }
    .choice:hover { background: var(--blue-soft); border-color: var(--blue); }
    .choice[aria-pressed="true"] { background: var(--blue-soft); border: 2px solid var(--blue); color: var(--blue-deep); font-weight: 750; }
    .quiz-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 24px; }
    .quiz-result { margin-top: 20px; padding: 20px; border-radius: 13px; background: var(--blue-soft); scroll-margin-top: 112px; }
    .quiz-result[hidden] { display: none; }
    .result-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 14px; }
    .result-card { padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 11px; }
    .result-card h4 { margin: 0 0 5px; font-size: 16px; }
    .result-card p { margin: 0; color: var(--muted); font-size: 14px; }
    .checklist { display: grid; gap: 10px; margin-top: 20px; padding: 21px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
    .checklist-title { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    .checklist-title h3 { margin: 0; }
    .checklist-items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .check-item { display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; background: var(--canvas); border: 1px solid var(--line); border-radius: 9px; cursor: pointer; }
    .check-item input { flex: 0 0 18px; width: 18px; min-height: 18px; height: 18px; margin: 2px 0 0; accent-color: var(--blue); }
    .progress-track { height: 9px; overflow: hidden; background: var(--soft); border-radius: 99px; }
    .progress-fill { width: 0; height: 100%; background: var(--green); border-radius: inherit; transition: width .2s ease; }
    .filter-row { display: flex; flex-wrap: wrap; gap: 9px; align-items: center; margin: 0 0 18px; }
    .filter-btn { min-height: 42px; padding: 8px 13px; color: var(--muted); background: var(--surface); border: 1px solid var(--line); border-radius: 9px; font-weight: 700; }
    .filter-btn[aria-pressed="true"] { color: var(--blue-deep); background: var(--blue-soft); border-color: var(--blue); }
    .resource-search { flex: 1 1 240px; max-width: 360px; }
    .resource.hidden { display: none; }
    .resource-group.empty { display: none; }
    .no-results { padding: 16px; color: var(--muted); background: var(--surface); border: 1px dashed var(--line); border-radius: 10px; }
    details { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; }
    details + details { margin-top: 10px; }
    summary { cursor: pointer; font-weight: 750; }
    details p { margin: 10px 0 0; color: var(--muted); }
    .footer { margin-top: 72px; padding: 28px 0 0; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
    .footer p { margin: 6px 0; }
    .back-top { display: inline-block; margin-top: 12px; font-weight: 700; }
    @media (max-width: 760px) {
      .header-inner { align-items: flex-start; flex-direction: column; gap: 8px; padding: 10px 18px; }
      .nav { justify-content: flex-start; gap: 2px; }
      .nav a { padding: 6px 8px; font-size: 13px; }
      main { padding: 22px 18px 54px; }
      .hero { grid-template-columns: 1fr; padding: 35px 24px; gap: 25px; }
      .hero-aside { max-width: none; }
      .section { padding-top: 58px; }
      .grid.two, .grid.three, .resource-list, .choice-grid, .result-grid, .checklist-items { grid-template-columns: 1fr; }
      .planner-grid { grid-template-columns: 1fr; }
      .field.full { grid-column: auto; }
    }
    @media (max-width: 420px) {
      .brand { font-size: 15px; }
      .nav a { font-size: 12px; }
      .hero { padding: 29px 20px; }
      .hero-copy { font-size: 16px; }
      .card, .planner { padding: 19px; }
      .section-heading p { font-size: 16px; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header" id="top">
    <div class="header-inner">
      <a class="brand" href="#top" aria-label="Self Discovery and Career Toolkit home"><span class="brand-mark" aria-hidden="true">↗</span><span>Self Discovery and Career Toolkit</span></a>
      <nav class="nav" aria-label="Main navigation">
        <a href="#know-yourself">Know yourself</a>
        <a href="#career-finder">Career finder</a>
        <a href="#explore">Explore careers</a>
        <a href="#pathways">Pathways</a>
        <a href="#plan">Make a plan</a>
        <a href="#resources">Resources</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow">A practical guide for Senior High School students</p>
        <h1 id="hero-title">Your next step starts with a question.</h1>
        <p class="hero-copy">Explore your strengths, research careers, and compare the paths that could take you toward work you find meaningful. You do not need to decide your whole future today.</p>
        <div class="hero-actions">
          <a class="button" href="#know-yourself">Start exploring <span aria-hidden="true">&nbsp;→</span></a>
          <a class="button secondary" href="#resources">Browse trusted resources</a>
        </div>
      </div>
      <aside class="hero-aside" aria-label="Four steps in this guide">
        <h2>A simple way to begin</h2>
        <ol class="steps-mini">
          <li><span class="step-no">1</span>Reflect on what matters to you</li>
          <li><span class="step-no">2</span>Explore careers with curiosity</li>
          <li><span class="step-no">3</span>Compare possible pathways</li>
          <li><span class="step-no">4</span>Choose one next step</li>
        </ol>
      </aside>
    </section>

    <section class="section" id="know-yourself" aria-labelledby="know-title">
      <div class="section-heading">
        <span class="label">01 · Reflect</span>
        <h2 id="know-title">Know yourself</h2>
        <p>A career decision is not only about a job title. Think about your interests, strengths, values, and practical needs. DepEd career-skills materials include self-assessment and decision-making as part of career preparation.<sup><a href="https://www.deped.gov.ph/wp-content/uploads/SHS_LCS_Q4_LE4_A.pdf" target="_blank" rel="noopener">Source</a></sup></p>
      </div>
      <div class="grid three">
        <article class="card">
          <div class="icon" aria-hidden="true">◎</div>
          <h3>What interests you?</h3>
          <p>Which subjects, activities, or topics make you curious? What do you enjoy learning about outside school?</p>
        </article>
        <article class="card green">
          <div class="icon" aria-hidden="true">✳</div>
          <h3>What are your strengths?</h3>
          <p>What do people ask you to help with? Which skills would you like to develop further?</p>
        </article>
        <article class="card gold">
          <div class="icon" aria-hidden="true">♡</div>
          <h3>What matters to you?</h3>
          <p>Consider creativity, stability, service, teamwork, independence, your work environment, and your practical needs.</p>
        </article>
      </div>
      <div class="prompt-list" aria-label="Reflection prompts">
        <div class="prompt"><strong>I’m curious about…</strong> ______________________________</div>
        <div class="prompt"><strong>I’d like to use my strength in…</strong> ______________________________</div>
        <div class="prompt"><strong>I value…</strong> ______________________________</div>
        <div class="prompt"><strong>One thing I need to find out is…</strong> ______________________________</div>
      </div>
      <div class="callout" style="margin-top:18px"><p><strong>Keep an open mind.</strong> Your interests and strengths can develop over time. Use reflection to guide your research—not to limit your choices.</p></div>
    </section>

    <section class="section" id="career-finder" aria-labelledby="finder-title">
      <div class="section-heading">
        <span class="label">Try a quick activity</span>
        <h2 id="finder-title">Find a few career areas to explore</h2>
        <p>Choose one answer in each group. You’ll get broad areas to research—not a test result or a career recommendation.</p>
      </div>
      <div class="quiz-shell" id="career-quiz">
        <div class="quiz-question" data-question="activity">
          <h3>1. Which activity sounds most interesting?</h3>
          <div class="choice-grid">
            <button class="choice" type="button" data-score="people:3">Helping or teaching people</button>
            <button class="choice" type="button" data-score="stem:3">Solving puzzles or problems</button>
            <button class="choice" type="button" data-score="creative:3,skilled:1">Designing or creating something</button>
            <button class="choice" type="button" data-score="skilled:3">Building, fixing, or making things</button>
            <button class="choice" type="button" data-score="business:3,people:1">Organizing a project or event</button>
            <button class="choice" type="button" data-score="nature:3,skilled:1">Working with nature or outdoors</button>
          </div>
        </div>
        <div class="quiz-question" data-question="style">
          <h3>2. What kind of work style appeals to you?</h3>
          <div class="choice-grid">
            <button class="choice" type="button" data-score="people:2,business:1">Collaborating with others</button>
            <button class="choice" type="button" data-score="stem:2,creative:1">Focusing on a challenge independently</button>
            <button class="choice" type="button" data-score="skilled:2,nature:1">Learning by doing hands-on work</button>
            <button class="choice" type="button" data-score="creative:2,people:1">Sharing ideas and communicating</button>
            <button class="choice" type="button" data-score="stem:2,business:1">Working with information or details</button>
            <button class="choice" type="button" data-score="nature:2,people:1">Being active in different settings</button>
          </div>
        </div>
        <div class="quiz-question" data-question="value">
          <h3>3. What would feel meaningful to you?</h3>
          <div class="choice-grid">
            <button class="choice" type="button" data-score="people:2">Supporting people or communities</button>
            <button class="choice" type="button" data-score="creative:2">Bringing new ideas to life</button>
            <button class="choice" type="button" data-score="stem:2,skilled:1">Solving practical challenges</button>
            <button class="choice" type="button" data-score="business:2">Helping a team or project succeed</button>
            <button class="choice" type="button" data-score="nature:2">Caring for the environment</button>
            <button class="choice" type="button" data-score="skilled:2,creative:1">Making something useful and tangible</button>
          </div>
        </div>
        <div class="quiz-actions">
          <button class="button" type="button" id="show-areas">Show areas to explore</button>
          <button class="button secondary" type="button" id="reset-quiz">Start over</button>
          <span class="small-note" id="quiz-status" aria-live="polite">Choose one option in each group.</span>
        </div>
        <div class="quiz-result" id="quiz-result" role="status" aria-live="polite" hidden></div>
      </div>
      <p class="small-note" style="margin-top:12px">This activity is only a brainstorming tool. It does not measure your abilities or determine which career is right for you.</p>
    </section>

    <section class="section" id="explore" aria-labelledby="explore-title">
      <div class="section-heading">
        <span class="label">02 · Research</span>
        <h2 id="explore-title">Explore careers</h2>
        <p>A job title alone does not tell you what a career is really like. Research the work, skills, qualifications, and settings involved. DepEd’s career-skills lesson materials recommend looking into job duties and possible education or certification requirements.<sup><a href="https://www.deped.gov.ph/wp-content/uploads/SHS_LCS_Q4_LE1.pdf" target="_blank" rel="noopener">Source</a></sup></p>
      </div>
      <div class="grid two">
        <article class="card career-card">
          <span class="label">Copy this research card for each option</span>
          <h3>Career research card</h3>
          <ul class="career-fields">
            <li>Career or role</li><li>What does a person in this role do?</li><li>What might a typical day involve?</li><li>What skills or knowledge may be useful?</li><li>What education, training, licence, or experience may be required?</li><li>Where might people do this work?</li><li>What interests me—and what do I still want to learn?</li><li>Which sources did I check, and when?</li>
          </ul>
        </article>
        <article class="card green">
          <div class="icon" aria-hidden="true">?</div>
          <h3>Ask someone in the field</h3>
          <ul class="list-clean">
            <li>What does a typical workday look like?</li>
            <li>What do you enjoy, and what is challenging?</li>
            <li>What training or experience helped you get started?</li>
            <li>What do you wish you had known earlier?</li>
            <li>What advice would you give a student exploring this work?</li>
          </ul>
        </article>
      </div>
      <p class="small-note" style="margin-top:14px">If you interview someone, ask permission before recording or sharing their answers. Career information can change: check dates, compare sources, and confirm requirements with the relevant institution or provider.</p>
    </section>

    <section class="section" id="pathways" aria-labelledby="pathways-title">
      <div class="section-heading">
        <span class="label">03 · Compare</span>
        <h2 id="pathways-title">Compare pathways</h2>
        <p>There is more than one way to move toward a career. Compare possible routes and check current requirements directly with the school, training provider, or employer.</p>
      </div>
      <div class="grid two">
        <article class="card pathway">
          <span class="path-tag">Higher education</span>
          <h3>College and other study</h3>
          <p>Explore programs that connect with your interests and goals. Check admission requirements, deadlines, costs, location, student support, and financial-assistance options. DepEd’s career-readiness materials discuss researching college opportunities and preparing applications.<sup><a href="https://www.deped.gov.ph/wp-content/uploads/SHS_LCS_Q4_LE4_A.pdf" target="_blank" rel="noopener">DepEd guide</a></sup></p>
          <p style="margin-top:12px"><a href="https://ched.gov.ph/" target="_blank" rel="noopener">CHED resources</a> · <a href="https://ched.gov.ph/unifast" target="_blank" rel="noopener">UniFAST assistance information</a><sup><a href="https://ched.gov.ph/unifast" target="_blank" rel="noopener">Source</a></sup></p>
        </article>
        <article class="card pathway green">
          <span class="path-tag">Technical-vocational</span>
          <h3>Skills training and certification</h3>
          <p>Look into the skills or qualification a program covers, its schedule and cost, and any assessment requirements. TESDA’s website provides training, scholarship, online-learning, assessment, and certification resources.<sup><a href="https://www.tesda.gov.ph/" target="_blank" rel="noopener">TESDA</a></sup></p>
          <p style="margin-top:12px"><a href="https://www.tesda.gov.ph/About/Tesda/51" target="_blank" rel="noopener">Labor-market reports</a> · <a href="https://www.tesda.gov.ph/About/Tesda/53" target="_blank" rel="noopener">TVET statistics</a></p>
        </article>
        <article class="card pathway gold">
          <span class="path-tag">Work</span>
          <h3>Entering the workforce</h3>
          <p>Research entry-level roles, requested skills, application documents, and ways to prepare for interviews. Check that job opportunities and employers are legitimate. <a href="https://philjobnet.gov.ph/" target="_blank" rel="noopener">PhilJobNet</a> is the Philippine government’s job-matching and labor-market information portal, with career information for students and jobseekers.<sup><a href="https://philjobnet.gov.ph/" target="_blank" rel="noopener">Source</a></sup></p>
        </article>
        <article class="card pathway">
          <span class="path-tag">Entrepreneurship</span>
          <h3>Starting a small venture</h3>
          <p>Before committing money, investigate who might need your product or service, what it may cost to operate, what skills or permissions you may need, and how you could test the idea on a small scale.</p>
        </article>
      </div>
      <div class="table-wrap" style="margin-top:20px" role="region" aria-label="Career pathway comparison table" tabindex="0">
        <table>
          <thead><tr><th>Option</th><th>What attracts me?</th><th>What do I need to find out?</th><th>Cost, time, or other considerations</th><th>My next step</th></tr></thead>
          <tbody><tr><td>Option 1</td><td></td><td></td><td></td><td></td></tr><tr><td>Option 2</td><td></td><td></td><td></td><td></td></tr><tr><td>Option 3</td><td></td><td></td><td></td><td></td></tr></tbody>
        </table>
      </div>
      <p class="small-note">You do not need to compare every possible path. Start with a few options that seem relevant to your goals and circumstances.</p>
    </section>

    <section class="section" id="plan" aria-labelledby="plan-title">
      <div class="section-heading">
        <span class="label">04 · Take action</span>
        <h2 id="plan-title">Make a plan</h2>
        <p>Choose a next step—not your whole future. A useful next step is specific, manageable, and helps you learn something.</p>
      </div>
      <form class="planner" id="career-planner">
        <div class="planner-grid">
          <div class="field"><label for="career">Career or pathway I want to explore</label><input id="career" name="career" placeholder="e.g., a role, course, or skill area"></div>
          <div class="field"><label for="why">Why I’m interested</label><input id="why" name="why" placeholder="What caught my attention?"></div>
          <div class="field full"><label for="find-out">What I still need to find out</label><textarea id="find-out" name="find-out" placeholder="Requirements, training, costs, daily tasks, or other questions"></textarea></div>
          <div class="field"><label for="helper">Who could help me?</label><input id="helper" name="helper" placeholder="Teacher, counselor, family member, mentor…"></div>
          <div class="field"><label for="next-step">My next small step</label><input id="next-step" name="next-step" placeholder="One action I can take"></div>
        </div>
        <div class="planner-actions">
          <button class="button" type="button" id="copy-plan">Copy my plan</button>
          <button class="button secondary" type="reset">Clear fields</button>
          <span class="small-note" id="plan-status" aria-live="polite">Your entries stay in this browser page and are not sent anywhere.</span>
        </div>
      </form>
      <div class="grid three" style="margin-top:18px">
        <article class="card"><h3>Ask</h3><p>Talk with a guidance counselor, teacher, or someone with experience in the field.</p></article>
        <article class="card green"><h3>Verify</h3><p>Confirm current requirements and details with the relevant school or provider.</p></article>
        <article class="card gold"><h3>Review</h3><p>After you learn more, decide whether to continue, adjust, or explore another option.</p></article>
      </div>
      <div class="checklist">
        <div class="checklist-title"><h3>My exploration progress</h3><span class="small-note" id="progress-label">0 of 4 complete</span></div>
        <div class="progress-track" role="progressbar" aria-label="Career exploration checklist progress" aria-valuemin="0" aria-valuemax="4" aria-valuenow="0"><div class="progress-fill" id="progress-fill"></div></div>
        <div class="checklist-items">
          <label class="check-item"><input type="checkbox" class="progress-check"><span>I wrote down interests or strengths I want to explore.</span></label>
          <label class="check-item"><input type="checkbox" class="progress-check"><span>I researched at least one career or role.</span></label>
          <label class="check-item"><input type="checkbox" class="progress-check"><span>I checked details with an official source.</span></label>
          <label class="check-item"><input type="checkbox" class="progress-check"><span>I talked with someone I trust about a next step.</span></label>
        </div>
      </div>
    </section>

    <section class="section" id="faq" aria-labelledby="faq-title">
      <div class="section-heading">
        <span class="label">A few common questions</span>
        <h2 id="faq-title">You can change your mind as you learn</h2>
      </div>
      <details><summary>Do I need to choose one career right now?</summary><p>No. Start by exploring a few possibilities and choosing a useful next step. More research and experience may change what interests you.</p></details>
      <details><summary>What if I don’t know what I’m interested in?</summary><p>Start with what you enjoy, what you are curious about, and what you want to learn. Try new activities, ask questions, and notice which tasks feel meaningful.</p></details>
      <details><summary>Should I choose a career only because I’m good at a subject?</summary><p>Your strengths are one part of the picture. Also consider your interests, values, preferred work environment, practical needs, and the requirements of each path.</p></details>
      <details><summary>Where can I check whether information is current?</summary><p>Start with official government, school, college, and training-provider websites. Confirm admission requirements, fees, deadlines, and qualifications directly with the institution.</p></details>
    </section>

    <section class="section" id="resources" aria-labelledby="resources-title">
      <div class="section-heading">
        <span class="label">Keep exploring</span>
        <h2 id="resources-title">Guides, websites, and videos</h2>
        <p>Use official sources to verify requirements and deadlines. For videos and general explainers, check the uploader and publication date before relying on the information.</p>
      </div>
      <div class="filter-row" role="group" aria-label="Filter resource types">
        <button class="filter-btn" type="button" data-filter="all" aria-pressed="true">All resources</button>
        <button class="filter-btn" type="button" data-filter="guide" aria-pressed="false">Guides</button>
        <button class="filter-btn" type="button" data-filter="website" aria-pressed="false">Websites</button>
        <button class="filter-btn" type="button" data-filter="video" aria-pressed="false">Videos</button>
        <input class="resource-search" id="resource-search" type="search" placeholder="Search resources…" aria-label="Search resources">
      </div>
      <p class="small-note" id="resource-count" aria-live="polite"></p>
      <div class="resource-group">
        <h3>Articles and guides</h3>
        <div class="resource-list">
          <article class="resource" data-category="guide"><a href="https://www.deped.gov.ph/wp-content/uploads/SHS_LCS_Q4_LE1.pdf" target="_blank" rel="noopener">DepEd · Life and Career Skills, Quarter 4, Lesson 1</a><p>Career research, job duties, abilities, and possible education or certification requirements.<sup><a href="https://www.deped.gov.ph/wp-content/uploads/SHS_LCS_Q4_LE1.pdf" target="_blank" rel="noopener">Source</a></sup></p></article>
          <article class="resource" data-category="guide"><a href="https://www.deped.gov.ph/wp-content/uploads/SHS_LCS_Q4_LE4_A.pdf" target="_blank" rel="noopener">DepEd · Life and Career Skills, Quarter 4, Lesson 4</a><p>Self-assessment, career readiness, researching college opportunities, and preparing applications.<sup><a href="https://www.deped.gov.ph/wp-content/uploads/SHS_LCS_Q4_LE4_A.pdf" target="_blank" rel="noopener">Source</a></sup></p></article>
          <article class="resource" data-category="guide"><a href="https://sites.google.com/deped.gov.ph/depedmanila-elibrary/self-learning-modules/career-guidance" target="_blank" rel="noopener">DepEd Manila e-Library · Career Guidance</a><p>Career-guidance modules and videos for different grade levels. Some materials may require a DepEd Gmail account.<sup><a href="https://sites.google.com/deped.gov.ph/depedmanila-elibrary/self-learning-modules/career-guidance" target="_blank" rel="noopener">Source</a></sup></p></article>
        </div>
      </div>
      <div class="resource-group">
        <h3>Official websites</h3>
        <div class="resource-list">
          <article class="resource" data-category="website"><a href="https://ched.gov.ph/" target="_blank" rel="noopener">CHED · Commission on Higher Education</a><p>Higher-education information and resources.<sup><a href="https://ched.gov.ph/" target="_blank" rel="noopener">Source</a></sup></p></article>
          <article class="resource" data-category="website"><a href="https://ched.gov.ph/unifast" target="_blank" rel="noopener">UniFAST</a><p>Information about student financial assistance. Check each program’s current eligibility rules and deadlines.<sup><a href="https://ched.gov.ph/unifast" target="_blank" rel="noopener">Source</a></sup></p></article>
          <article class="resource" data-category="website"><a href="https://www.tesda.gov.ph/" target="_blank" rel="noopener">TESDA</a><p>Technical-vocational education and training resources, including courses, scholarships, online learning, assessment, and certification.<sup><a href="https://www.tesda.gov.ph/" target="_blank" rel="noopener">Source</a></sup></p></article>
          <article class="resource" data-category="website"><a href="https://www.tesda.gov.ph/About/Tesda/51" target="_blank" rel="noopener">TESDA · Labor Market Intelligence Reports</a><p>Labor-market information to use as one part of career research.<sup><a href="https://www.tesda.gov.ph/About/Tesda/51" target="_blank" rel="noopener">Source</a></sup></p></article>
          <article class="resource" data-category="website"><a href="https://www.tesda.gov.ph/About/Tesda/53" target="_blank" rel="noopener">TESDA · Philippine TVET Statistics</a><p>Statistics and related resources about technical-vocational education and training.<sup><a href="https://www.tesda.gov.ph/About/Tesda/53" target="_blank" rel="noopener">Source</a></sup></p></article>
          <article class="resource" data-category="website"><a href="https://philjobnet.gov.ph/" target="_blank" rel="noopener">PhilJobNet</a><p>Philippine government job-matching and labor-market information portal, with career information for students and jobseekers.<sup><a href="https://philjobnet.gov.ph/" target="_blank" rel="noopener">Source</a></sup></p></article>
        </div>
      </div>
      <div class="resource-group">
        <h3>YouTube videos and channels</h3>
        <div class="resource-list">
          <article class="resource" data-category="video"><a href="https://www.youtube.com/@DepEd_PH/videos" target="_blank" rel="noopener">DepEd Philippines · YouTube</a><p>Browse videos from the Department of Education.</p></article>
          <article class="resource" data-category="video"><a href="https://www.youtube.com/channel/UC_w9xbX95tns9mXrPjAjuHw" target="_blank" rel="noopener">TESDA Official · YouTube</a><p>Browse videos about skills training and technical-vocational education.</p></article>
          <article class="resource" data-category="video"><a href="https://www.youtube.com/watch?v=pHeUPLvSWeA" target="_blank" rel="noopener">Career Guidance Program National Kick-Off</a><p>A recording about the Career Guidance Program. Check the posting channel and date before relying on it for current policies.</p></article>
          <article class="resource" data-category="video"><a href="https://www.youtube.com/watch?v=5P93DdSWfJw" target="_blank" rel="noopener">DepEd Career Guidance Program 2025</a><p class="caution">Supplementary explainer. Check the uploader and verify policy details with official DepEd sources.</p></article>
        </div>
      </div>
      <p class="no-results" id="no-resource-results" hidden>No resources match that search. Try another keyword or choose a different filter.</p>
    </section>

    <footer class="footer">
      <p><strong>Research reminder:</strong> Requirements, fees, scholarship conditions, and application dates can change. Confirm important details directly with the relevant school, college, training provider, or government agency.</p>
      <p>This guide is a starting point for exploration—not a test, official admissions advice, or a guarantee of employment.</p>
      <a class="back-top" href="#top">Back to top ↑</a>
    </footer>
  </main>
  <script>
    const quizQuestions = [...document.querySelectorAll('.quiz-question')];
    const quizStatus = document.getElementById('quiz-status');
    const quizResult = document.getElementById('quiz-result');
    const areaInfo = {
      people: { name: 'People, education & community', text: 'Explore roles and programs focused on teaching, care, support, or community service.' },
      creative: { name: 'Creative work & communication', text: 'Explore design, media, communication, and other ways of developing or sharing ideas.' },
      stem: { name: 'Science, technology & problem-solving', text: 'Explore fields that investigate questions, use data, or solve technical and practical problems.' },
      business: { name: 'Business, organization & leadership', text: 'Explore work involving planning, coordination, entrepreneurship, or helping projects and teams succeed.' },
      skilled: { name: 'Skilled trades & making', text: 'Explore hands-on work involving building, maintaining, repairing, producing, or technical services.' },
      nature: { name: 'Nature, agriculture & environment', text: 'Explore work connected to plants, animals, natural resources, sustainability, or the outdoors.' }
    };
    quizQuestions.forEach(question => {
      question.querySelectorAll('.choice').forEach(choice => {
        choice.setAttribute('aria-pressed', 'false');
        choice.addEventListener('click', () => {
          question.querySelectorAll('.choice').forEach(button => button.setAttribute('aria-pressed', 'false'));
          choice.setAttribute('aria-pressed', 'true');
          quizResult.hidden = true;
          quizStatus.textContent = 'Answer saved for this group.';
        });
      });
    });
    document.getElementById('show-areas').addEventListener('click', () => {
      const selected = quizQuestions.map(question => question.querySelector('.choice[aria-pressed="true"]'));
      const missingQuestion = quizQuestions.find(question => !question.querySelector('.choice[aria-pressed="true"]'));
      if (missingQuestion) {
        quizStatus.textContent = 'Choose one answer in each of the three groups first.';
        missingQuestion.querySelector('.choice')?.focus();
        return;
      }
      const scores = {};
      selected.forEach(choice => {
        choice.dataset.score.split(',').forEach(pair => {
          const [area, points] = pair.split(':');
          scores[area] = (scores[area] || 0) + Number(points);
        });
      });
      const topAreas = Object.keys(scores).sort((a, b) => scores[b] - scores[a]).slice(0, 3);
      quizResult.innerHTML = `<h3>Your starting points to explore</h3><p>These are broad areas to research—not a diagnosis or a ranked career match. See which one interests you most, then use the career research card below.</p><div class="result-grid">${topAreas.map(area => `<article class="result-card"><h4>${areaInfo[area].name}</h4><p>${areaInfo[area].text}</p></article>`).join('')}</div>`;
      quizResult.hidden = false;
      quizStatus.textContent = 'Your exploration ideas are ready.';
      quizResult.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    document.getElementById('reset-quiz').addEventListener('click', () => {
      quizQuestions.forEach(question => question.querySelectorAll('.choice').forEach(button => button.setAttribute('aria-pressed', 'false')));
      quizResult.hidden = true;
      quizStatus.textContent = 'Choose one option in each group.';
    });

    const progressChecks = [...document.querySelectorAll('.progress-check')];
    const progressFill = document.getElementById('progress-fill');
    const progressLabel = document.getElementById('progress-label');
    const progressBar = document.querySelector('[role="progressbar"]');
    function updateProgress() {
      const checked = progressChecks.filter(item => item.checked).length;
      progressLabel.textContent = `${checked} of ${progressChecks.length} complete`;
      progressFill.style.width = `${(checked / progressChecks.length) * 100}%`;
      progressBar.setAttribute('aria-valuenow', String(checked));
    }
    progressChecks.forEach(item => item.addEventListener('change', updateProgress));

    let activeResourceFilter = 'all';
    const searchInput = document.getElementById('resource-search');
    const resourceCards = [...document.querySelectorAll('.resource[data-category]')];
    const resourceGroups = [...document.querySelectorAll('.resource-group')];
    const resourceCount = document.getElementById('resource-count');
    const noResults = document.getElementById('no-resource-results');
    function filterResources() {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;
      resourceCards.forEach(card => {
        const categoryMatches = activeResourceFilter === 'all' || card.dataset.category === activeResourceFilter;
        const textMatches = card.textContent.toLowerCase().includes(query);
        const visible = categoryMatches && textMatches;
        card.classList.toggle('hidden', !visible);
        if (visible) visibleCount++;
      });
      resourceGroups.forEach(group => {
        const hasVisible = [...group.querySelectorAll('.resource')].some(card => !card.classList.contains('hidden'));
        group.classList.toggle('empty', !hasVisible);
      });
      resourceCount.textContent = `${visibleCount} resource${visibleCount === 1 ? '' : 's'} shown`;
      noResults.hidden = visibleCount !== 0;
    }
    document.querySelectorAll('.filter-btn').forEach(button => {
      button.addEventListener('click', () => {
        activeResourceFilter = button.dataset.filter;
        document.querySelectorAll('.filter-btn').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        filterResources();
      });
    });
    searchInput.addEventListener('input', filterResources);
    filterResources();

    const copyButton = document.getElementById('copy-plan');
    const status = document.getElementById('plan-status');
    copyButton.addEventListener('click', async () => {
      const fields = [
        ['Career or pathway', 'career'],
        ['Why I’m interested', 'why'],
        ['What I still need to find out', 'find-out'],
        ['Who could help me', 'helper'],
        ['My next small step', 'next-step']
      ];
      const content = fields.map(([label, id]) => `${label}: ${document.getElementById(id).value.trim() || '—'}`).join('\n');
      try {
        await navigator.clipboard.writeText(content);
        status.textContent = 'Plan copied. Paste it into your notes to keep it.';
      } catch (error) {
        status.textContent = 'Copy was unavailable in this browser. You can select and copy your entries manually.';
      }
    });
    document.getElementById('career-planner').addEventListener('reset', () => {
      status.textContent = 'Your entries stay in this browser page and are not sent anywhere.';
    });
  </script>
